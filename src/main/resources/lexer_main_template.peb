package {{ packageName }};

import java.util.*;

/**
 * Generated main class for testing and running the {{ lexerClassName }} lexer.
 * This class provides a command-line interface for tokenizing input text.
 */
public class {{ mainClassName }} {
    
    public static void main(String[] args) {
        if (args.length == 0) {
            printUsage();
            return;
        }
        
        String input = args[0];
        {{ lexerClassName }} lexer = new {{ lexerClassName }}(input);
        
        System.out.println("=== {{ lexerClassName }} Tokenization Results ===");
        System.out.println("Input: \"" + input + "\"");
        System.out.println();
        
        try {
            // Get all tokens
            List<{{ lexerClassName }}.Token> tokens = lexer.getAllTokens();
            
            System.out.println("Tokens found:");
            System.out.println("------------");
            
            for ({{ lexerClassName }}.Token token : tokens) {
                System.out.printf("Type: %-15s | Value: \"%s\" | Position: %d%n", 
                    token.getType(), 
                    escapeString(token.getValue()), 
                    token.getPosition());
            }
            
            System.out.println();
            System.out.println("Total tokens: " + tokens.size());
            
            // Check for errors
            long errorCount = tokens.stream()
                .filter(token -> "ERROR".equals(token.getType()))
                .count();
            
            if (errorCount > 0) {
                System.out.println("WARNING: " + errorCount + " error token(s) found!");
            } else {
                System.out.println("✓ No errors found - all input was successfully tokenized!");
            }
            
        } catch (Exception e) {
            System.err.println("Error during tokenization: " + e.getMessage());
            e.printStackTrace();
        }
    }
    
    private static void printUsage() {
        System.out.println("Usage: java {{ mainClassName }} \"<input_string>\"");
        System.out.println();
        System.out.println("Examples:");
        System.out.println("  java {{ mainClassName }} \"hello world\"");
        System.out.println("  java {{ mainClassName }} \"123 456\"");
        System.out.println("  java {{ mainClassName }} \"a b c\"");
        System.out.println();
        System.out.println("This lexer recognizes the following patterns:");
{% for state in acceptingStates %}
        System.out.println("  - {{ tokenTypes[state] }}: {{ state }}");
{% endfor %}
    }
    
    private static String escapeString(String value) {
        if (value == null) return "null";
        
        StringBuilder sb = new StringBuilder();
        for (char c : value.toCharArray()) {
            switch (c) {
                case '\n': sb.append("\\n"); break;
                case '\r': sb.append("\\r"); break;
                case '\t': sb.append("\\t"); break;
                case '\\': sb.append("\\\\"); break;
                case '"': sb.append("\\\""); break;
                default: sb.append(c); break;
            }
        }
        return sb.toString();
    }
    
    /**
     * Interactive mode for testing the lexer with multiple inputs.
     */
    public static void runInteractiveMode() {
        Scanner scanner = new Scanner(System.in);
        
        System.out.println("=== {{ lexerClassName }} Interactive Mode ===");
        System.out.println("Enter input strings to tokenize (type 'quit' to exit):");
        System.out.println();
        
        while (true) {
            System.out.print("Input> ");
            String input = scanner.nextLine().trim();
            
            if ("quit".equalsIgnoreCase(input) || "exit".equalsIgnoreCase(input)) {
                break;
            }
            
            if (input.isEmpty()) {
                continue;
            }
            
            {{ lexerClassName }} lexer = new {{ lexerClassName }}(input);
            
            try {
                List<{{ lexerClassName }}.Token> tokens = lexer.getAllTokens();
                
                System.out.println("Tokens:");
                for ({{ lexerClassName }}.Token token : tokens) {
                    System.out.printf("  %-15s \"%s\" (pos: %d)%n", 
                        token.getType(), 
                        escapeString(token.getValue()), 
                        token.getPosition());
                }
                
                long errorCount = tokens.stream()
                    .filter(token -> "ERROR".equals(token.getType()))
                    .count();
                
                if (errorCount > 0) {
                    System.out.println("  ⚠ " + errorCount + " error(s)");
                } else {
                    System.out.println("  ✓ " + tokens.size() + " token(s) - no errors");
                }
                
            } catch (Exception e) {
                System.out.println("  ✗ Error: " + e.getMessage());
            }
            
            System.out.println();
        }
        
        scanner.close();
        System.out.println("Goodbye!");
    }
}